rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /playlists/{playlistId} {
      allow read: if resource.data.public == true || 
                   (request.auth != null && (request.auth.uid == resource.data.userId || isAdmin()));
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if docId == 'gdrive_api' || docId == 'global' || (request.auth != null);
      allow write: if isAdmin();
    }

    match /catalogs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
