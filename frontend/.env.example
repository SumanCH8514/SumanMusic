# ============================================
# SumanMusic — Frontend Environment Variables
# ============================================
# Copy this file to `.env` and fill in your values.
# cp .env.example .env

# Google Drive Configuration
# Create API keys at: https://console.cloud.google.com/apis/credentials
# Enable "Google Drive API" for each key
VITE_GDRIVE_API_KEY_1=your_gdrive_api_key_here
VITE_GDRIVE_API_KEY_2=
VITE_GDRIVE_API_KEY_3=
VITE_GDRIVE_API_KEY_4=
VITE_GDRIVE_FOLDER_ID=your_google_drive_folder_id

# Firebase Configuration
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# YouTube API Configuration (for Online Library)
# Create keys at: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for each key
# Multiple keys enable automatic rotation and failover
VITE_YOUTUBE_API_KEY=your_primary_youtube_api_key
VITE_YOUTUBE_API_KEY_1=
VITE_YOUTUBE_API_KEY_2=
VITE_YOUTUBE_API_KEY_3=

# Last.fm API Key (for artist metadata and images)
# Get a free key at: https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=your_lastfm_api_key

# Redis (Upstash) REST API Configuration
# For caching Google Drive metadata, lyrics, and search results
# Sign up at: https://upstash.com
VITE_UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Backend URL (optional — defaults to the Cloudflare Worker)
# VITE_BACKEND_URL=https://api.backend.songs.sumanonline.com
